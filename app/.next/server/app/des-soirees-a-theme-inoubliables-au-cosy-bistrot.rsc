1e:T9a1,{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://lecosybistrot27.fr/#organization","name":"Le Cosy Bistrot","url":"https://lecosybistrot27.fr/","telephone":"+33227360549"},{"@type":"WebSite","@id":"https://lecosybistrot27.fr/#website","url":"https://lecosybistrot27.fr/","name":"Le Cosy Bistrot","inLanguage":"fr-FR","publisher":{"@id":"https://lecosybistrot27.fr/#organization"}},{"@type":"BreadcrumbList","@id":"https://lecosybistrot27.fr/des-soirees-a-theme-inoubliables-au-cosy-bistrot/#breadcrumblist","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"https://lecosybistrot27.fr/"},{"@type":"ListItem","position":2,"name":"Soirée évènement","item":"https://lecosybistrot27.fr/articles/"},{"@type":"ListItem","position":3,"name":"Des soirées à thème inoubliables au Cosy Bistrot","item":"https://lecosybistrot27.fr/des-soirees-a-theme-inoubliables-au-cosy-bistrot/"}]},{"@type":"WebPage","@id":"https://lecosybistrot27.fr/des-soirees-a-theme-inoubliables-au-cosy-bistrot/#webpage","url":"https://lecosybistrot27.fr/des-soirees-a-theme-inoubliables-au-cosy-bistrot/","name":"Soirées à thème toute occasion - Le Cosy Bistrot","description":"Venez nous rejoindre à Bourg-Achard et découvrez les soirées à thème organisées au Cosy Bistrot. N'oubliez pas de réserver votre place directement en ligne !","inLanguage":"fr-FR","isPartOf":{"@id":"https://lecosybistrot27.fr/#website"},"breadcrumb":{"@id":"https://lecosybistrot27.fr/des-soirees-a-theme-inoubliables-au-cosy-bistrot/#breadcrumblist"}},{"@type":"BlogPosting","@id":"https://lecosybistrot27.fr/des-soirees-a-theme-inoubliables-au-cosy-bistrot/#blogposting","headline":"Des soirées à thème inoubliables au Cosy Bistrot","description":"Venez nous rejoindre à Bourg-Achard et découvrez les soirées à thème organisées au Cosy Bistrot. N'oubliez pas de réserver votre place directement en ligne !","datePublished":"2024-10-21T19:08:00","dateModified":"2024-03-27T09:06:23","inLanguage":"fr-FR","articleSection":"Soirée évènement","mainEntityOfPage":{"@id":"https://lecosybistrot27.fr/des-soirees-a-theme-inoubliables-au-cosy-bistrot/#webpage"},"publisher":{"@id":"https://lecosybistrot27.fr/#organization"},"author":{"@id":"https://lecosybistrot27.fr/#organization"},"image":{"@type":"ImageObject","url":"https://admin.lecosybistrot27.fr/wp-content/uploads/2024/03/Des-soirees-a-theme-inoubliables-au-Cosy-Bistrot.jpg"}}]}21:T976,<p class="wp-block-paragraph"><em>Pour des moments magiques et des souvenirs mémorables, rien de tel que de rejoindre nos soirées à thème spéciales au Cosy Bistrot. Que ce soit pour célébrer la Saint-Valentin, le Nouvel An ou Noël, nous vous invitons à vivre des expériences uniques dans une ambiance festive et chaleureuse.</em></p>



<h2 class="wp-block-heading">Célébrez avec Style avec vos collègues et amis</h2>



<p class="wp-block-paragraph">Nos <strong>soirées à thème </strong>sont conçues pour vous offrir une expérience unique et inoubliable. Dès que vous franchirez les portes du <strong>Cosy Bistrot</strong>, vous serez transporté dans un univers enchanté où chaque détail contribue à créer une atmosphère magique. Des décorations festives aux menus spéciaux élaborés par nos chefs talentueux, tout est pensé pour que vous puissiez célébrer avec style et élégance.</p>



<h2 class="wp-block-heading">Ne manquez pas nos soirées à thème</h2>



<p class="wp-block-paragraph">Lors de nos soirées à thème, l&rsquo;ambiance est à la fête ! Profitez de la musique entraînante, des <strong>animations spéciales</strong> et de l&rsquo;énergie contagieuse de nos convives pour vivre des moments de joie et de convivialité. Que vous veniez en couple, entre amis ou en famille, vous êtes sûr de passer une soirée inoubliable au Cosy Bistrot.</p>



<h2 class="wp-block-heading">Détente et convivialité au Cosy Bistrot</h2>



<p class="wp-block-paragraph">Les soirées à thème sont l&rsquo;occasion parfaite de créer des souvenirs précieux avec vos proches. Que ce soit pour partager un <em>dîner romantique</em> à l&rsquo;occasion de la Saint-Valentin, pour fêter le passage à la nouvelle année lors du <strong>Nouvel An</strong>, ou pour célébrer la magie de <strong>Noël en famille</strong>, nos soirées à thème ne laissent personne indifférent.</p>



<h2 class="wp-block-heading">Réservez votre place dès maintenant</h2>



<p class="wp-block-paragraph">Ne manquez pas l&rsquo;opportunité de <a href="https://admin.lecosybistrot27.fr/evenement/" target="_blank" rel="noopener" title="">vivre des soirées à thème inoubliables au Cosy Bistrot</a>. Réservez dès maintenant pour garantir votre place lors de nos prochains événements. Nous avons hâte de vous accueillir pour des moments festifs dont vous vous souviendrez longtemps !</p>f:["$","article",null,{"className":"mx-auto w-full max-w-[calc(var(--container-article)+2rem)] px-4 pt-2 pb-[30px]","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}],["$","h1",null,{"className":"titre-1 mb-4 text-rouge-vif","children":"Des soirées à thème inoubliables au Cosy Bistrot"}],["$","$L20",null,{"src":"https://admin.lecosybistrot27.fr/wp-content/uploads/2024/03/Des-soirees-a-theme-inoubliables-au-Cosy-Bistrot.jpg","alt":"Des soirées à thème inoubliables au Cosy Bistrot","width":600,"height":400,"sizes":"(min-width: 640px) 600px, 100vw","preload":true,"loading":"eager","className":"mb-4 h-auto w-full max-w-[600px]"}],["$","div",null,{"className":"prose-cosy","dangerouslySetInnerHTML":{"__html":"$21"}}]]}]
