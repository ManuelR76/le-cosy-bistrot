18:[["$","title","0",{"children":"Accueil - Le Cosy Bistrot"}],["$","meta","1",{"name":"description","content":"Bienvenue au Cosy Bistrot Restaurant a Bourg-Achard Découvrez le Cosy Bistrot à Bourg-Achard, un lieu chaleureux où la fraîcheur des produits se marie à une ambiance conviviale.Avec une capacité de 80 couverts, notre restaurant offre une expérience culinaire unique.Réservez dès maintenant par téléphone pour savourer une cuisine maison, ouverte tous les jours sauf le dimanche."}],["$","meta","2",{"name":"robots","content":"index, follow, max-image-preview:large"}],["$","link","3",{"rel":"canonical","href":"https://lecosybistrot27.fr/"}],["$","meta","4",{"property":"og:title","content":"Accueil - Le Cosy Bistrot"}],["$","meta","5",{"property":"og:description","content":"Bienvenue au Cosy Bistrot Restaurant a Bourg-Achard Découvrez le Cosy Bistrot à Bourg-Achard, un lieu chaleureux où la fraîcheur des produits se marie à une ambiance conviviale.Avec une capacité de 80 couverts, notre restaurant offre une expérience culinaire unique.Réservez dès maintenant par téléphone pour savourer une cuisine maison, ouverte tous les jours sauf le dimanche."}],["$","meta","6",{"property":"og:url","content":"https://lecosybistrot27.fr/"}],["$","meta","7",{"property":"og:site_name","content":"Le Cosy Bistrot"}],["$","meta","8",{"property":"og:locale","content":"fr_FR"}],["$","meta","9",{"property":"og:type","content":"website"}],["$","meta","10",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","11",{"name":"twitter:title","content":"Accueil - Le Cosy Bistrot"}],["$","meta","12",{"name":"twitter:description","content":"Bienvenue au Cosy Bistrot Restaurant a Bourg-Achard Découvrez le Cosy Bistrot à Bourg-Achard, un lieu chaleureux où la fraîcheur des produits se marie à une ambiance conviviale.Avec une capacité de 80 couverts, notre restaurant offre une expérience culinaire unique.Réservez dès maintenant par téléphone pour savourer une cuisine maison, ouvert